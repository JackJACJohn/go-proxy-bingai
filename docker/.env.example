# Go Proxy BingAI Docker Environment Example
# 将本示例复制为 .env 并根据需求修改

# 主服务访问端口
PORT=8080

# 日志级别: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# 可选：开启本地模式，仅监听 127.0.0.1
# LOCAL_MODE=true

# 可选：开启调试模式，代理 web 资源
# Go_Proxy_BingAI_Debug=true

# 人机验证服务器地址
BYPASS_SERVER=https://bypass.zklcdc.xyz

# 可选：Bing 基础地址
# BING_BASE_URL=https://www.bing.com
# SYDNEY_BASE_URL=https://sydney.bing.com

# 可选：代理配置
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890

# 可选：自定义用户令牌，支持多个
# Go_Proxy_BingAI_USER_TOKEN_1=token1
# Go_Proxy_BingAI_USER_TOKEN_2=token2

# 可选：用户 Cookie，保持登录状态
# USER_KievRPSSecAuth=your_cookie
# USER_RwBf=your_cookie
# USER_MUID=your_cookie

# 可选：接口访问控制，为多个密钥使用逗号分隔
# Go_Proxy_BingAI_AUTH_KEY=sk-xx,sk-yy

# ====== With Pass 版本需要配置 ======
# Cloudflare Zero Trust Token
# CF_ZERO_TRUST_TOKEN=your_cf_token

# 内部 API 密钥 (强烈建议修改)
# APIKEY=sk-change-this-key
