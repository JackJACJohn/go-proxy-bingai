{
  "install": {
    "include": [
      "go.mod",
      "go.sum",
      "main.go",
      "api",
      "common",
      "web"
    ],
    "exclude": ["frontend", "docs", "docker", "cloudflare", "web/assets"]
  },
  "throttle": 600,
  "restart": {
    "exclude": ["**/*.md", "**/*.log", "docs/**"]
  },
  "commands": {
    "start": "bash glitch-start.sh"
  }
}
